# ==============================================================================
# Ztopus Environment Configuration Template
# Copy this file to .env and set your secrets/credentials
# ==============================================================================

# Gemini AI API Key: Required for Ztopus AI assistant and opportunity parser.
# In Google AI Studio Build, this is automatically provided by runtime capabilities.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# AI Model Configuration
GEMINI_CHAT_MODEL="gemini-3.1-flash-lite"
GEMINI_PARSER_MODEL="gemini-3.8-flash"

# Server Network Configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
